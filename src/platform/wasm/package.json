{
  "name": "@thenick775/mgba-wasm",
  "version": "2.4.1",
  "description": "mGBA emulator compiled to webassembly",
  "main": "./dist/mgba.js",
  "types": "./dist/mgba.d.ts",
  "files": [
    "./dist/mgba.js",
    "./dist/mgba.d.ts",
    "./dist/mgba.wasm",
    "./dist/mgba.wasm.map"
  ],
  "scripts": {
    "build": "npm run build:wasm && npm run copy:dist && echo 'mGBA-wasm built successfully!'",
    "build:wasm": "node ./scripts/build-wasm.mjs",
    "build:image": "echo 'No Docker image is required; npm run build uses the local npm emsdk toolchain.'",
    "build:docker": "cd ./docker && docker build -t local-mgba/wasm:2.0 . && cd ../../.. && docker run --rm -t -v $PWD:/home/mgba/src local-mgba/wasm:2.0",
    "copy:dist": "node ./scripts/copy-dist.mjs",
    "prepare": "node ./scripts/prepare-package.mjs",
    "prepack": "npm run build",
    "clean": "rm -rf ./dist ../../../build-wasm"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenick775/mgba.git"
  },
  "keywords": [
    "mGBA",
    "wasm",
    "web-assembly",
    "webassembly",
    "emscripten",
    "emulator",
    "emulation",
    "javascript",
    "typescript",
    "game boy",
    "game boy color",
    "game boy advance"
  ],
  "author": "Nicholas VanCise",
  "license": "MPL-2.0",
  "bugs": {
    "url": "https://github.com/thenick775/mgba/issues"
  },
  "homepage": "https://github.com/thenick775/mgba/tree/feature/wasm#readme",
  "devDependencies": {
    "emsdk": "0.4.0"
  }
}
